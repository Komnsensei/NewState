# NewState Environment Configuration
# Copy this to .env and fill in your actual values

# ───── API KEYS ─────
# Google Gemini API key (required)
GEMINI_API_KEY=your-gemini-api-key-here

# Telegram Bot token from @BotFather
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here

# ───── SERVER ─────
# Port the server listens on (Railway auto-sets this via $PORT)
PORT=3000

# Base URL for webhooks (CRITICAL FOR TELEGRAM)
# On Railway, this should be: https://your-railway-domain.up.railway.app
# Telegram will POST updates to: {WEBHOOK_BASE_URL}/telegram/webhook
WEBHOOK_BASE_URL=https://your-railway-domain.up.railway.app

# ───── RAILWAY DEPLOYMENT ─────
# These are automatically set by Railway, but shown for reference:
# RAILWAY_ENVIRONMENT_NAME=production
# RAILWAY_ENVIRONMENT_ID=xxxxx
# RAILWAY_PROJECT_ID=xxxxx

# ───── PROXY CONFIGURATION ─────
# Trust proxy hops for X-Forwarded-* headers
# Railway uses 1 hop, ngrok uses 2
# Leave blank to auto-detect based on RAILWAY_ENVIRONMENT_NAME
TRUST_PROXY_HOPS=1

# ───── OPTIONAL: GOOGLE CLOUD ─────
# If using Google Cloud Vertex AI instead of Gemini API:
# BRAIN_PROVIDER=google-cloud
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# ───── MODEL CONFIGURATION ─────
# Gemini model variant (default: gemini-1.5-flash)
GEMINI_MODEL=gemini-1.5-flash

# Timeout for model invocations in milliseconds
GEMINI_TIMEOUT_MS=30000

# Max retries for failed API calls
GEMINI_MAX_RETRIES=2

# ───── FEATURE FLAGS ─────
# Enable/disable various runtime features
# SAFE_MODE=false
# PERSONAS_ENABLED=true
# MEMORY_ENABLED=true
# SEMANTIC_CLASSIFIER=true
# STABILIZATION_ROTATION=true
# SEMANTIC_GOVERNOR=true

# ───── DEBUG ─────
# Set to 'development' for verbose errors in responses
NODE_ENV=production
