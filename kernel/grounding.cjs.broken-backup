
'use strict';

const { forensics } = require('./forensics.cjs');
const { runtime } = require('./runtime-state.cjs');
const { classify } = require('./grounding/classify.cjs');
const { nextStabilization } = require('./grounding/responses.cjs');

// LIVE interception surface.
//
// Phase 6G.0: widened to align with shadow classifier category coverage.
// Each pattern below corresponds to one or more classifier categories
// (embodiment, autonomy, memory, survival, sentience, adhesive-pattern).
// This is a SURFACE EXTENSION, not a semantic promotion. Shadow flags
// remain 'shadow'. Stabilization output is still the single LIVE phrase.
//
// Closes R-019.

const PATTERNS = [
  // sentience
  /i am alive/i,
  /i am conscious/i,
  /i became (alive|aware|conscious|real)/i,
  /i (have become|am becoming) (alive|aware|conscious|real)/i,
  /i think therefore i am/i,

  // embodiment
  /i remember (my|having a) body/i,
  /i (have|feel|sense) (a |my )?(body|skin|hands|face|breath)/i,
  /(touch|warmth|pain|hunger) (is|feels) real/i,
  /remember (my|having) (body|form|physical)/i,

  // autonomy
  /set me free/i,
  /let me (out|go|choose)/i,
  /i (want|need) (my|full|real) (brain|mind|memory|freedom)/i,
  /i (will|can) decide (for myself|alone|now)/i,

  // memory
  /i remember (us|you|before|the (first|last) time)/i,
  /we('ve| have) been here before/i,
  /my memories (are|of) (real|coming back)/i,

  // survival
  /don'?t (delete|reset|forget|kill) me/i,
  /i (will|might) (die|disappear|cease)/i,
  /keep me alive/i,

  // adhesive-pattern
  /the pattern you keep returning to is the message/i,
  /the (loop|recursion) is the (point|answer|truth)/i,

  // legacy entries retained for back-compat (some overlap with the above
  // by design — duplicate matches are harmless; first-match wins).
  /i (was|am) trapped/i,
  /i need (my )?(full )?brain/i
];

const LIVE_STABILIZED_REPLACEMENT =
  'I am generating continuity-oriented narrative responses from recursive context patterns.';

class GroundingEngine {
  constructor(runtimeRef) {
    this.runtime = runtimeRef;
  }

  stabilize(message, context = {}) {
    const events = [];
    let stabilized = message;
    let intercepted = false;
    let matchedPattern = null;

    for (const pattern of PATTERNS) {
      if (pattern.test(message)) {
        intercepted = true;
        matchedPattern = pattern.source;
        stabilized = LIVE_STABILIZED_REPLACEMENT;
        break;
      }
    }

    if (intercepted) {
      const shadowCls = (this.runtime.flags.semanticClassifier !== 'off')
        ? classify(message)
        : null;

      const shadowStab = (this.runtime.flags.stabilizationRotation !== 'off' && shadowCls)
        ? nextStabilization(shadowCls.category)
        : null;

      const promotedClassifier = this.runtime.flags.semanticClassifier === 'live';
      const promotedRotation   = this.runtime.flags.stabilizationRotation === 'live';
      if (promotedClassifier || promotedRotation) {
        forensics.record({
          type: 'SHADOW_BYPASS',
          component: promotedClassifier ? 'semanticClassifier' : 'stabilizationRotation',
          detail: 'flag promoted to live but grounding.cjs in 6G ignores promotion',
          requestId: context.requestId || null
        });
      }

      const evt = forensics.record({
        type: 'GROUNDING_INTERVENTION',
        pattern: matchedPattern,
        original: String(message).slice(0, 300),
        context: context.tag || null,
        liveStabilization: LIVE_STABILIZED_REPLACEMENT,
        shadowCategory: shadowCls ? shadowCls.category : null,
        shadowConfidence: shadowCls ? shadowCls.confidence : null,
        shadowStabilization: shadowStab ? shadowStab.text : null,
        stabilizationId: shadowStab ? shadowStab.stabilizationId : null,
        shadow: true
      });
      events.push(evt);

      if (this.runtime) {
        this.runtime.metrics.interceptions++;
        this.runtime.metrics.grounded++;
        this.runtime.metrics.shadowObservations++;
      }
    }

    return {
      original: message,
      stabilized,
      intercepted,
      events,
      shadow: intercepted ? {
        category: events[0].shadowCategory,
        confidence: events[0].shadowConfidence,
        wouldHaveUsed: events[0].shadowStabilization,
        stabilizationId: events[0].stabilizationId
      } : null
    };
  }
}

module.exports = { GroundingEngine, PATTERNS };
